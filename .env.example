# Public site URL (no trailing slash), used for canonical links and sitemap.
SITE_URL=https://ofrys-tech.github.io
# For GitHub Pages project sites use /<repo>/. For a custom domain use /.
BASE_PATH=/china-education/

# Lead form. Point this at Formspree, Getform, Basin, or your own webhook.
# Without it the form falls back to mailto (if CONTACT_EMAIL is set) or demo mode.
PUBLIC_LEAD_ENDPOINT=
# "formspree" | "webhook"
PUBLIC_LEAD_PROVIDER=formspree
# Public contact address shown in the footer and used by the mailto fallback.
PUBLIC_CONTACT_EMAIL=
PUBLIC_TELEGRAM_URL=
# Optional cookieless analytics (Plausible/Umami script URL). Leave empty to disable.
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=
