---
import Icon from "@/components/Icon.astro";

interface Props {
  name: string;
  nameZh: string;
  city: string;
  strengths: string[];
  language: string;
  scholarship: boolean;
  href: string;
  index: number;
  external?: boolean;
  note?: string;
}

const {
  name,
  nameZh,
  city,
  strengths,
  language,
  scholarship,
  href,
  index,
  external = false,
  note,
} = Astro.props;
---

<a
	class="university-row reveal"
	href={href}
	target={external ? "_blank" : undefined}
	rel={external ? "noopener noreferrer" : undefined}
>
	<span class="university-row__num">{String(index).padStart(2, "0")}</span>
	<h3 class="university-row__name">{name}<span>{nameZh} · {city}</span></h3>
	<p class="university-row__meta">{language}</p>
	<div class="university-row__tags">
		{strengths.slice(0, 2).map((item) => <span class="tag">{item}</span>)}
		{scholarship && <span class="tag tag--jade">стипендии</span>}
	</div>
	<span class="university-row__arrow" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
	{note && <p class="university-row__note">{note}</p>}
</a>
