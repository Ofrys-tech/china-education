---
import { common } from "@/i18n/en/common";
import { withBase } from "@/lib/url";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label={common.ui.breadcrumb}>
	<a href={withBase("/")}>{common.ui.home}</a>
	{items.map((item) => (
		item.href ? <a href={withBase(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>
	))}
</nav>
