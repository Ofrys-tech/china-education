---
import Emblem from "@/components/Emblem.astro";
import Icon from "@/components/Icon.astro";
import { common } from "@/i18n/en/common";
import { isExternal, withBase } from "@/lib/url";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = common.ui.nextStep,
  title,
  text,
  ctaLabel = common.ui.applyNow,
  ctaHref = "/apply/",
  secondaryLabel = common.ui.askQuestion,
  secondaryHref = "/faq/",
} = Astro.props;

const primaryHref = isExternal(ctaHref) ? ctaHref : withBase(ctaHref);
const secondaryLink = isExternal(secondaryHref) ? secondaryHref : withBase(secondaryHref);
---

<section class="cta-band">
	<div class="shell">
		<div class="cta-band__inner">
			<div>
				<span class="eyebrow eyebrow--light">{eyebrow}</span>
				<h2 class="display display--l mt-2">{title}</h2>
			</div>
			<div>
				<p class="lead">{text}</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href={primaryHref} data-track="band_cta">
						{ctaLabel}
						<Icon name="arrowUpRight" size={16} />
					</a>
					<a class="btn btn--outline-gold" href={secondaryLink}>
						{secondaryLabel}
					</a>
				</div>
			</div>
		</div>
	</div>
	<Emblem class="cta-band__glyph" />
</section>
