---
import Icon from "@/components/Icon.astro";
import { common } from "@/i18n/en/common";
import { labels } from "@/i18n/en/labels";
import { withBase } from "@/lib/url";

type Degree = "language" | "foundation" | "bachelor" | "master" | "phd";

interface Props {
  title: string;
  summary: string;
  degree: Degree;
  duration: string;
  languages: (keyof typeof labels.languages)[];
  tuition: string;
  href: string;
  index: number;
  featured?: boolean;
}

const {
  title,
  summary,
  degree,
  duration,
  languages,
  tuition,
  href,
  index,
  featured = false,
} = Astro.props;

const icons = {
  language: "language",
  foundation: "book",
  bachelor: "cap",
  master: "doc",
  phd: "flask",
} as const;

const languageLabel = languages.map((lang) => labels.languages[lang]).join(" / ");
---

<article class:list={["program-card reveal", { "program-card--featured": featured }]}>
	<div class="program-card__top">
		<span class="program-card__icon"><Icon name={icons[degree]} size={20} /></span>
		<span class="program-card__num">{String(index).padStart(2, "0")}</span>
	</div>
	<h3 class="program-card__title">{title}</h3>
	<p class="program-card__desc">{summary}</p>
	<div class="program-card__meta">
		<span>{duration}</span>
		<span>{languageLabel}</span>
		<span>{tuition}</span>
	</div>
	<a class="program-card__link" href={withBase(href)} aria-label={`${common.ui.readMore}: ${title}`}></a>
	<span class="program-card__arrow" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
</article>
