---
import Emblem from "@/components/Emblem.astro";
import { siteConfig } from "@/config/site";
import { common } from "@/i18n/en/common";
import { withBase } from "@/lib/url";

interface Props {
  compact?: boolean;
  inverse?: boolean;
  showTagline?: boolean;
}

const { compact = false, inverse = false, showTagline = false } = Astro.props;
---

<a
  class:list={["brand", { "brand--inverse": inverse, "brand--compact": compact }]}
  href={withBase("/")}
  aria-label={`${siteConfig.fullName} — ${common.ui.home}`}
>
  <span class="brand__mark"><Emblem /></span>
  <span class="brand__type">
    <span class="brand__name">ADLAS</span>
    <span class="brand__sub">
      <span class="brand__rule" aria-hidden="true"></span>
      <span>STUDY</span>
      <span class="brand__rule" aria-hidden="true"></span>
    </span>
    {showTagline && <span class="brand__tag">{siteConfig.tagline}</span>}
  </span>
</a>
