---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class={`emblem ${className}`}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <ellipse
    cx="32"
    cy="32"
    rx="28"
    ry="10"
    transform="rotate(-27 32 32)"
    stroke="currentColor"
    stroke-width="1"
    opacity=".55"
  ></ellipse>
  <path
    d="M32 6.2 11.4 56.4h8.1l4.9-11.9h15.2l4.9 11.9h8.1L32 6.2Zm-5.2 31.1 5.2-12.6 5.2 12.6H26.8Z"
    fill="currentColor"
  ></path>
  <path
    d="M53.9 9.2c.5 2.9 1.8 4.2 4.7 4.7-2.9.5-4.2 1.8-4.7 4.7-.5-2.9-1.8-4.2-4.7-4.7 2.9-.5 4.2-1.8 4.7-4.7Z"
    fill="currentColor"
  ></path>
  <path
    d="M9.2 42.2c1.7 4.9 8.2 8.4 16.1 8.4 8.3 0 15-3.9 16.3-9"
    stroke="currentColor"
    stroke-width="1"
    opacity=".55"
