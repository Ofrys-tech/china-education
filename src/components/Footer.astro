---
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import { siteConfig } from "@/config/site";
import { common } from "@/i18n/en/common";
import { withBase } from "@/lib/url";

const year = new Date().getFullYear();
const legalLinks = [
  { label: common.footer.privacy, href: "/privacy/" },
  { label: common.footer.process, href: "/process/" },
  { label: common.footer.about, href: "/about/" },
];
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo inverse showTagline />
        <p class="site-footer__desc">{common.footer.description}</p>
        <p class="site-footer__desc" style="color:var(--color-gold);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;margin-top:1rem">
          {siteConfig.community}
        </p>
        <div class="site-footer__social">
          <a href={siteConfig.contacts.whatsapp} rel="noopener noreferrer" target="_blank">
            <Icon name="whatsapp" size={14} /> WhatsApp
          </a>
          <a href={siteConfig.contacts.instagram} rel="noopener noreferrer" target="_blank">
            <Icon name="instagram" size={14} /> Instagram
          </a>
          <a href={siteConfig.contacts.channel} rel="noopener noreferrer" target="_blank">
            <Icon name="channel" size={14} /> Channel
          </a>
        </div>
      </div>

      <div>
        <p class="site-footer__heading">{common.footer.sections}</p>
        <ul class="site-footer__links">
          {common.nav.map((item) => (
            <li><a href={withBase(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="site-footer__heading">{common.footer.contact}</p>
        <ul class="site-footer__links">
          <li>
            <a href={siteConfig.contacts.whatsapp} rel="noopener noreferrer" target="_blank">
              {siteConfig.contacts.whatsappLabel}
            </a>
          </li>
          <li><a href={`mailto:${siteConfig.contacts.email}`}>{siteConfig.contacts.email}</a></li>
          <li>
            <a href={siteConfig.contacts.instagram} rel="noopener noreferrer" target="_blank">
              {siteConfig.contacts.instagramLabel}
            </a>
          </li>
          <li><a href={withBase("/contact/")}>{common.footer.form}</a></li>
        </ul>
      </div>

      <div>
        <p class="site-footer__heading">{common.footer.legal}</p>
        <ul class="site-footer__links">
          {legalLinks.map((item) => (
            <li><a href={withBase(item.href)}>{item.label}</a></li>
          ))}
          <li><a href={withBase("/apply/")}>{common.footer.apply}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {siteConfig.fullName}. {common.footer.rights}</p>
      <p class="site-footer__legal">{common.legal.disclaimer}</p>
      <a href={withBase("/contact/")} class="link-arrow" style="color:var(--color-cream)">
        {common.footer.discuss} <Icon name="arrowUpRight" size={15} />
      </a>
    </div>
  </div>
</footer>
