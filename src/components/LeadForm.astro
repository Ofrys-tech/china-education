---
import Icon from "@/components/Icon.astro";
import { forms } from "@/i18n/en/forms";
import { labels } from "@/i18n/en/labels";
import {
  CONTACT_METHOD_VALUES,
  DEGREE_VALUES,
  DIRECTION_VALUES,
  INTAKE_VALUES,
} from "@/lib/leads/options";
import { endpointFor, type LeadProvider } from "@/lib/leads/payload";
import { withBase } from "@/lib/url";

interface Props {
  variant?: "full" | "compact";
  source?: string;
}

const { variant = "full", source = "site" } = Astro.props;
const isCompact = variant === "compact";

const provider = (import.meta.env.PUBLIC_LEAD_PROVIDER ?? "formspree") as LeadProvider;
const configuredEndpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "").trim();
const action = endpointFor(provider, configuredEndpoint);
const email = (import.meta.env.PUBLIC_CONTACT_EMAIL ?? "").trim();
const telegram = (import.meta.env.PUBLIC_TELEGRAM_URL ?? "").trim();
---

<div class="lead-form-wrap" id="lead-form">
  <form
    class="lead-form"
    data-lead-form
    data-source={source}
    data-email={email}
    data-telegram={telegram}
    method="post"
    action={action || undefined}
    novalidate
  >
    <div class="lead-form__grid">
      <div class="field">
        <label for="lead-name">{forms.labels.name} <span aria-hidden="true">*</span></label>
        <input
          id="lead-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder={forms.placeholders.name}
          required
          aria-describedby="lead-name-error"
        />
        <p class="field__error" id="lead-name-error" data-error-for="name" hidden></p>
      </div>

      <div class="field">
        <label for="lead-contact-method">{forms.labels.contactMethod} <span aria-hidden="true">*</span></label>
        <select id="lead-contact-method" name="contactMethod" required data-contact-method>
          <option value="">{forms.labels.choose}</option>
          {CONTACT_METHOD_VALUES.map((value) => (
            <option
              value={value}
              data-label={labels.contactMethods[value].label}
              data-placeholder={labels.contactMethods[value].placeholder}
              data-inputmode={labels.contactMethods[value].inputmode}
            >
              {labels.contactMethods[value].label}
            </option>
          ))}
        </select>
        <p class="field__error" data-error-for="contactMethod" hidden></p>
      </div>

      <div class="field lead-form__grid--full">
        <label for="lead-contact">
          <span data-contact-label-text>{forms.labels.contact}</span> <span aria-hidden="true">*</span>
        </label>
        <input
          id="lead-contact"
          name="contact"
          type="text"
          autocomplete="tel"
          placeholder={forms.placeholders.contactFallback}
          required
          data-contact-input
          aria-describedby="lead-contact-error lead-contact-hint"
        />
        <p class="field__error" id="lead-contact-error" data-error-for="contact" hidden></p>
        <p class="field__hint" id="lead-contact-hint">{forms.placeholders.contactHint}</p>
      </div>

      {!isCompact && (
        <div class="field">
          <label for="lead-degree">{forms.labels.degree} <span aria-hidden="true">*</span></label>
          <select id="lead-degree" name="degree" required>
            <option value="">{forms.labels.choose}</option>
            {DEGREE_VALUES.map((value) => <option value={value}>{labels.degrees[value]}</option>)}
          </select>
          <p class="field__error" data-error-for="degree" hidden></p>
        </div>
      )}

      <div class="field">
        <label for="lead-direction">{forms.labels.direction} <span aria-hidden="true">*</span></label>
        <select id="lead-direction" name="direction" required>
          <option value="">{forms.labels.choose}</option>
          {DIRECTION_VALUES.map((value) => <option value={value}>{labels.directions[value]}</option>)}
        </select>
        <p class="field__error" data-error-for="direction" hidden></p>
      </div>

      {!isCompact && (
        <>
          <div class="field">
            <label for="lead-intake">{forms.labels.intake} <span aria-hidden="true">*</span></label>
            <select id="lead-intake" name="intake" required>
              <option value="">{forms.labels.choose}</option>
              {INTAKE_VALUES.map((value) => <option value={value}>{labels.intakes[value]}</option>)}
            </select>
            <p class="field__error" data-error-for="intake" hidden></p>
          </div>
          <div class="field lead-form__grid--full">
            <label for="lead-message">{forms.labels.message}</label>
            <textarea id="lead-message" name="message" rows="4" maxlength="1000"
              placeholder={forms.placeholders.message}></textarea>
            <p class="field__error" data-error-for="message" hidden></p>
          </div>
        </>
      )}
    </div>

    {isCompact && (
      <>
        <input type="hidden" name="degree" value="undecided" />
        <input type="hidden" name="intake" value="2027" />
        <input type="hidden" name="message" value="" />
      </>
    )}

    <input type="hidden" name="startedAt" value="" data-started-at />
    <input type="hidden" name="pageUrl" value="" data-page-url />
    <input type="hidden" name="referrer" value="" data-referrer />
    <input type="hidden" name="utm_source" value="" data-utm="source" />
    <input type="hidden" name="utm_medium" value="" data-utm="medium" />
    <input type="hidden" name="utm_campaign" value="" data-utm="campaign" />
    <input type="hidden" name="utm_content" value="" data-utm="content" />
    <input type="hidden" name="utm_term" value="" data-utm="term" />

    <div class="honeypot" aria-hidden="true">
      <label for="lead-website">{forms.labels.honeypot}</label>
      <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" value="true" required />
      <span>
        {forms.consent.before}
        <a href={withBase("/privacy/")}>{forms.consent.link}</a>{forms.consent.after}
      </span>
    </label>
    <p class="field__error" data-error-for="consent" hidden></p>

    <div class="form-status" data-form-status hidden aria-live="polite"></div>

    <button class="btn btn--primary" type="submit">
      <span data-submit-label>{forms.submit.idle}</span>
      <Icon name="arrowUpRight" size={16} />
    </button>
    <p class="note">{forms.footerNote}</p>
  </form>

  <div class="form-success" data-form-success hidden aria-live="polite">
    <span class="eyebrow">{forms.success.eyebrow}</span>
    <h3>{forms.success.title}</h3>
    <p class="muted">{forms.success.text}</p>
    <button class="link-arrow" type="button" data-form-reset style="justify-self:start">
      {forms.success.reset}
    </button>
  </div>

  <noscript>
    <p class="note mt-2">
      {forms.noscript}
      {email ? <a href={`mailto:${email}`}>{email}</a> : null}
      {telegram ? <a href={telegram}>Telegram</a> : null}
      {!email && !telegram ? forms.noscriptNoContact : null}
    </p>
  </noscript>
</div>

<script>
  import "@/scripts/lead-form";
</script>
