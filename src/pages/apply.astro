---
import Icon from "@/components/Icon.astro";
import LeadForm from "@/components/LeadForm.astro";
import PageHero from "@/components/PageHero.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl } from "@/lib/url";

const page = copy.apply;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: page.meta.title,
  url: absoluteUrl("/apply/"),
  about: { "@type": "Organization", name: siteConfig.fullName },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <PageHero
    breadcrumb={page.breadcrumb}
    eyebrow={page.hero.eyebrow}
    titleLines={page.hero.titleLines}
    lead={page.hero.lead}
    aside={page.hero.aside}
    link={page.hero.privacyLink}
    linkHref="/privacy/"
  />

  <section class="section" id="form">
    <div class="shell">
      <div class="detail-grid">
        <div>
          <p class="mono-label">{page.form.label}</p>
          <h2 class="display display--m mt-1">{page.form.title}</h2>
          <p class="muted mt-2" style="max-width:38rem">{page.form.intro}</p>
          <div class="mt-4">
            <LeadForm variant="full" source="apply" />
          </div>
        </div>

        <aside class="detail-aside">
          <div class="panel panel--ruled">
            <p class="mono-label">{page.after.label}</p>
            <ol class="mt-2" style="display:grid;gap:1.1rem">
              {page.after.items.map((item, index) => (
                <li>
                  <span class="mono-label" style="color:var(--color-red)">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p style="font-weight:600;margin-top:.2rem">{item.title}</p>
                  <p class="note" style="margin-top:.25rem">{item.text}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="panel">
            <p class="mono-label">{page.bring.label}</p>
            <ul class="checklist mt-2" style="grid-template-columns:1fr">
              {page.bring.items.map((item) => (
                <li><Icon name="check" size={15} /> {item}</li>
              ))}
            </ul>
          </div>

          <div class="panel">
            <p class="mono-label">{page.direct.label}</p>
            <div class="cluster mt-2">
              <a
                class="btn btn--sm btn--primary"
                href={siteConfig.contacts.whatsapp}
                rel="noopener noreferrer"
                target="_blank"
              >
                <Icon name="whatsapp" size={15} /> WhatsApp
              </a>
              <a class="btn btn--sm btn--ghost" href={`mailto:${siteConfig.contacts.email}`}>
                <Icon name="mail" size={15} /> Email
              </a>
              <a
                class="btn btn--sm btn--ghost"
                href={siteConfig.contacts.instagram}
                rel="noopener noreferrer"
                target="_blank"
              >
                <Icon name="instagram" size={15} /> Instagram
              </a>
            </div>
          </div>

          <p class="note">{copy.common.legal.disclaimer}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>