---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import LeadForm from "@/components/LeadForm.astro";
import Lines from "@/components/Lines.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const page = copy.apply;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: page.meta.title,
  url: absoluteUrl("/apply/"),
  about: { "@type": "Organization", name: siteConfig.name },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <p class="mt-2">
            <a href={withBase("/privacy/")} style="text-decoration:underline">
              {page.hero.privacyLink}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="form">
    <div class="shell">
      <div class="detail-grid">
        <div>
          <p class="mono-label">{page.form.label}</p>
          <h2 class="display display--m mt-1">{page.form.title}</h2>
          <p class="muted mt-2" style="max-width:38rem">{page.form.intro}</p>
          <div class="mt-4">
            <LeadForm variant="full" source="apply" />
          </div>
        </div>

        <aside class="detail-aside">
          <div class="panel panel--ruled">
            <p class="mono-label">{page.after.label}</p>
            <ol class="mt-2" style="display:grid;gap:1.1rem">
              {page.after.items.map((item, index) => (
                <li>
                  <span class="mono-label" style="color:var(--color-red)">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p style="font-weight:600;margin-top:.2rem">{item.title}</p>
                  <p class="note" style="margin-top:.25rem">{item.text}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="panel">
            <p class="mono-label">{page.bring.label}</p>
            <ul class="checklist mt-2" style="grid-template-columns:1fr">
              {page.bring.items.map((item) => (
                <li><Icon name="check" size={15} /> {item}</li>
              ))}
            </ul>
          </div>

          {(siteConfig.contacts.email || siteConfig.contacts.telegram) && (
            <div class="panel">
              <p class="mono-label">{page.direct.label}</p>
              <div class="cluster mt-2">
                {siteConfig.contacts.email && (
                  <a class="link-arrow" href={`mailto:${siteConfig.contacts.email}`}>
                    {siteConfig.contacts.email}
                  </a>
                )}
                {siteConfig.contacts.telegram && (
                  <a
                    class="link-arrow"
                    href={siteConfig.contacts.telegram}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Telegram
                  </a>
                )}
              </div>
            </div>
          )}

          <p class="note">{copy.common.legal.disclaimer}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>