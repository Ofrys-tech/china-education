---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";

const page = copy.styleguide;

const colors = [
  ["paper", "#f7f3eb", "--color-paper"],
  ["paper-soft", "#fbf8f2", "--color-paper-soft"],
  ["paper-deep", "#efe8db", "--color-paper-deep"],
  ["ink", "#191512", "--color-ink"],
  ["muted", "#6a6055", "--color-muted"],
  ["red", "#b23a2e", "--color-red"],
  ["jade", "#2c5f50", "--color-jade"],
  ["gold", "#b08a45", "--color-gold"],
];
---

<BaseLayout title={page.meta.title} description={page.meta.description} noindex>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <a class="link-arrow mt-2" href={withBase("/")}>
            {page.hero.home} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div>
          <span class="section-head__index">{page.colors.index}</span>
          <div class="display display--m">{page.colors.title}</div>
        </div>
        <div class="section-head__aside">{page.colors.aside}</div>
      </div>
      <div class="swatches">
        {colors.map(([name, hex, token]) => (
          <div class="swatch">
            <div class="swatch__color" style={`background:${hex}`}></div>
            <div class="swatch__label">{name}<br />{hex}<br />{token}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <div class="section-head">
        <div>
          <span class="section-head__index">{page.type.index}</span>
          <div class="display display--m">{page.type.title}</div>
        </div>
        <div class="section-head__aside">{page.type.aside}</div>
      </div>
      {page.type.samples.map((item) => (
        <div class="specimen">
          <span class="specimen__meta">{item.label} · .{item.className}</span>
          <span class={item.className}>{item.sample}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <div class="section-head">
        <div>
          <span class="section-head__index">{page.components.index}</span>
          <div class="display display--m">{page.components.title}</div>
        </div>
        <div class="section-head__aside">{page.components.aside}</div>
      </div>
      <div class="cluster">
        {page.components.buttons.map((label, index) => (
          <a
            class:list={["btn", index === 0 ? "btn--primary" : index === 1 ? "btn--ghost" : "btn--light"]}
            href={withBase("/apply/")}
          >
            {label} <Icon name="arrowUpRight" size={15} />
          </a>
        ))}
      </div>
      <div class="cluster mt-3">
        {page.components.tags.map((tag, index) => (
          <span class:list={["tag", { "tag--red": index === 2, "tag--jade": index === 1 }]}>{tag}</span>
        ))}
      </div>

      <div class="split mt-5">
        <div class="panel panel--ruled">
          <p class="mono-label">{page.components.fieldsLabel}</p>
          <div class="field mt-2">
            <label for="demo-name">{page.components.nameLabel}</label>
            <input id="demo-name" type="text" placeholder={page.components.namePlaceholder} />
          </div>
          <div class="field mt-2">
            <label for="demo-select">{page.components.selectLabel}</label>
            <select id="demo-select">
              {page.components.selectOptions.map((option) => <option>{option}</option>)}
            </select>
          </div>
        </div>
        <div class="panel">
          <p class="mono-label">{page.components.statusesLabel}</p>
          {page.components.statuses.map((status) => (
            <div class="form-status mt-2" data-state={status.state}>{status.text}</div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>