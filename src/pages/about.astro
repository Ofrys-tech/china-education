---
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const page = copy.about;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: page.meta.title,
  description: page.meta.description,
  url: absoluteUrl("/about/"),
  about: {
    "@type": "EducationalOrganization",
    name: siteConfig.fullName,
    description: siteConfig.description,
    url: absoluteUrl("/"),
  },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <PageHero
    breadcrumb={page.breadcrumb}
    eyebrow={page.hero.eyebrow}
    titleLines={page.hero.titleLines}
    lead={page.hero.lead}
    aside={page.hero.aside}
    link="Talk to ADLAS"
    linkHref="/contact/"
  />

  <section class="statement">
    <div class="shell statement__inner">
      <p class="display display--l" style="max-width:52rem">{page.statement}</p>
      <span class="statement__mark" aria-hidden="true">{page.statementMark}</span>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="split split--wide">
        <div>
          <SectionHead index={page.intro.index} eyebrow={page.intro.eyebrow}>
            <Fragment slot="title"><Lines lines={page.intro.titleLines} /></Fragment>
          </SectionHead>
          {page.intro.paragraphs.map((paragraph) => (
            <p class="mt-3" style="font-size:1.02rem;line-height:1.7">{paragraph}</p>
          ))}
        </div>
        <aside class="panel panel--gold">
          <p class="mono-label">Our position</p>
          <p class="mt-2" style="font-size:1rem;line-height:1.65">{page.intro.aside}</p>
          <a class="link-arrow mt-3" href={withBase("/experience/")}>
            Admission results <Icon name="arrowUpRight" size={14} />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <section class="ink section">
    <div class="shell">
      <div class="split">
        <div>
          <span class="eyebrow eyebrow--light">{page.mission.label}</span>
          <p class="display display--l mt-3" style="color:var(--color-cream)">{page.mission.text}</p>
        </div>
        <div>
          <span class="eyebrow eyebrow--light">{page.vision.label}</span>
          <p class="display display--l mt-3" style="color:var(--color-cream)">{page.vision.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index={page.values.index} eyebrow={page.values.eyebrow}>
        <Fragment slot="title"><Lines lines={page.values.titleLines} /></Fragment>
        <Fragment slot="aside">{page.values.aside}</Fragment>
      </SectionHead>

      <div class="value-grid reveal">
        {page.values.items.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.philosophy.index} eyebrow={page.philosophy.eyebrow}>
        <Fragment slot="title"><Lines lines={page.philosophy.titleLines} /></Fragment>
      </SectionHead>

      <div class="split split--wide">
        <blockquote class="display display--l" style="margin:0;max-width:26ch">
          “{page.philosophy.quote}”
        </blockquote>
        <div>
          {page.philosophy.paragraphs.map((paragraph) => (
            <p class="mt-3" style="font-size:1.02rem;line-height:1.7">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.approach.index} eyebrow={page.approach.eyebrow}>
        <Fragment slot="title"><Lines lines={page.approach.titleLines} /></Fragment>
      </SectionHead>
      <div class="value-grid">
        {page.approach.items.map((item, index) => (
          <article class="lux-card">
            <span class="lux-card__kicker">0{index + 1} / ADLAS</span>
            <h3 class="mt-2">{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.boundaries.index} eyebrow={page.boundaries.eyebrow}>
        <Fragment slot="title"><Lines lines={page.boundaries.titleLines} /></Fragment>
        <Fragment slot="aside">{page.boundaries.aside}</Fragment>
      </SectionHead>
      <div class="split">
        <div class="panel panel--ruled">
          <p class="mono-label">{page.boundaries.titleLines[0]}</p>
          <ul class="checklist mt-2" style="grid-template-columns:1fr">
            {page.boundaries.suitable.map((item) => (
              <li><Icon name="check" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="panel panel--gold">
          <p class="mono-label">{page.boundaries.titleLines[1]}</p>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.boundaries.notSuitable.map((item) => (
              <li><Icon name="x" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/process/"
  />
</BaseLayout>
