---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import SectionHead from "@/components/SectionHead.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const page = copy.about;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: page.meta.title,
  url: absoluteUrl("/about/"),
  about: {
    "@type": "Organization",
    name: siteConfig.name,
    description: siteConfig.description,
    url: absoluteUrl("/"),
  },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="shell statement__inner">
      <p class="display display--l" style="max-width:56rem">{page.statement}</p>
      <span class="statement__mark" aria-hidden="true">{page.statementMark}</span>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index={page.principles.index} eyebrow={page.principles.eyebrow}>
        <Fragment slot="title"><Lines lines={page.principles.titleLines} /></Fragment>
        <Fragment slot="aside">{page.principles.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.principles.cards.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.boundaries.index} eyebrow={page.boundaries.eyebrow}>
        <Fragment slot="title"><Lines lines={page.boundaries.titleLines} /></Fragment>
        <Fragment slot="aside">{page.boundaries.aside}</Fragment>
      </SectionHead>
      <div class="split">
        <div class="panel panel--ruled">
          <p class="mono-label">{page.boundaries.titleLines[0]}</p>
          <ul class="checklist mt-2" style="grid-template-columns:1fr">
            {page.boundaries.suitable.map((item) => (
              <li><Icon name="check" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="panel">
          <p class="mono-label">{page.boundaries.titleLines[1]}</p>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.boundaries.notSuitable.map((item) => (
              <li><Icon name="x" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="split mt-5">
        <div>
          <h3 class="display display--m">{page.included.title}</h3>
          <p class="muted mt-2">{page.included.text}</p>
        </div>
        <div>
          <h3 class="display display--m">{page.notDoing.title}</h3>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.notDoing.items.map((item) => (
              <li><Icon name="x" size={15} /> {item}</li>
            ))}
          </ul>
          <a class="link-arrow mt-3" href={withBase("/apply/")}>
            {page.cta.primary} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/process/"
  />
</BaseLayout>