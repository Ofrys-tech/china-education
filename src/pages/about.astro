---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import SectionHead from "@/components/SectionHead.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const principles = [
  {
    title: "Один куратор",
    text: "Не конвейер и не «отдел продаж». Один человек ведёт профиль, документы и переписку, пока вы не заедете в общежитие.",
  },
  {
    title: "Прозрачные вероятности",
    text: "Говорим «амбициозно», «реалистично» и «страховка» до оплаты. Если шансов нет — не продаём надежду.",
  },
  {
    title: "Источники, а не слухи",
    text: "Требования, дедлайны и стоимость проверяем по официальным страницам вузов. Всё, что меняется, перепроверяем на год поступления.",
  },
  {
    title: "После оффера",
    text: "Зачисление — не финиш. JW202, виза, жильё, страховка и первые дни на кампусе входят в работу.",
  },
];

const suitable = [
  "Хотите учиться в Китае и готовы начать за 8–12 месяцев",
  "Нужен честный разбор шансов, а не «гарантия»",
  "Готовы участвовать: давать документы и обратную связь",
  "Цените понятную смету и один канал связи",
];

const notSuitable = [
  "Нужен диплом за деньги без учёбы",
  "Требуется гарантированное зачисление или стипендия",
  "Готовы ехать только в один вуз и не рассматриваете альтернативы",
  "Нужна работа и виза без учебной программы",
];

const pageLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `О ${siteConfig.name}`,
  url: absoluteUrl("/about/"),
  about: {
    "@type": "Organization",
    name: siteConfig.name,
    description: siteConfig.description,
    url: absoluteUrl("/"),
  },
};
---

<BaseLayout
	title="О практике"
	description="ChinaPath — независимая консультационная практика по поступлению в Китай. Принципы работы, границы возможностей и кому мы подходим."
	jsonLd={pageLd}
>
	<section class="page-hero">
		<div class="shell">
			<Breadcrumbs items={[{ label: "О нас" }]} />
			<div class="page-hero__inner">
				<div>
					<span class="eyebrow">Практика · {siteConfig.yearFounded}</span>
					<h1 class="display display--l page-hero__title">Не конвейер.<br />Штаб поступления.</h1>
					<p class="lead page-hero__lead">
						Мы работаем с небольшим числом студентов, чтобы каждый профиль был собран
						вручную. Без «потока», шаблонных эссе и обещаний, которые нельзя выполнить.
					</p>
				</div>
				<div class="page-hero__aside">
					<p>
						ChinaPath — независимая практика, не университет и не его официальный
						представитель. Решение о зачислении всегда принимает вуз.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="statement">
		<div class="shell statement__inner">
			<p class="display display--l" style="max-width:56rem">
				Наша работа — не отправить заявку. Наша работа — чтобы через четыре года вы не
				пожалели о решении.
			</p>
			<span class="statement__mark" aria-hidden="true">道</span>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<SectionHead index="01 / Принципы" eyebrow="Как мы думаем">
				<Fragment slot="title">Четыре правила,<br />которые не меняем.</Fragment>
				<Fragment slot="aside">
					Они делают работу медленнее, чем «пакет за три дня», но именно они позволяют
					спокойно смотреть на результат.
				</Fragment>
			</SectionHead>
			<div class="value-grid reveal">
				{principles.map((item, index) => (
					<article class="value-card">
						<span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
						<div>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section--ruled">
		<div class="shell">
			<SectionHead index="02 / Границы" eyebrow="Честность">
				<Fragment slot="title">Кому подходим.<br />Кому нет.</Fragment>
				<Fragment slot="aside">
					Лучше отказать на старте, чем имитировать процесс и брать деньги за заведомо
					нереалистичный сценарий.
				</Fragment>
			</SectionHead>
			<div class="split">
				<div class="panel panel--ruled">
					<p class="mono-label">Хорошее совпадение</p>
					<ul class="checklist mt-2" style="grid-template-columns:1fr">
						{suitable.map((item) => <li><Icon name="check" size={15} /> {item}</li>)}
					</ul>
				</div>
				<div class="panel">
					<p class="mono-label">Не наша история</p>
					<ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
						{notSuitable.map((item) => <li><Icon name="x" size={15} /> {item}</li>)}
					</ul>
				</div>
			</div>

			<div class="split mt-5">
				<div>
					<h3 class="display display--m">Что входит в работу</h3>
					<p class="muted mt-2">
						Диагностика, стратегия, проверка требований, документы, эссе и рекомендации,
						подача, переписка с вузами, оффер, депозит, JW202, виза, жильё и брифинг перед
						перелётом.
					</p>
				</div>
				<div>
					<h3 class="display display--m">Чего не делаем</h3>
					<ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
						<li><Icon name="x" size={15} /> Не гарантируем зачисление или стипендию</li>
						<li><Icon name="x" size={15} /> Не сдаём экзамены и не пишем эссе вместо студента</li>
						<li><Icon name="x" size={15} /> Не обещаем визу: решение принимает консульство</li>
						<li><Icon name="x" size={15} /> Не передаём данные третьим лицам для рекламы</li>
					</ul>
					<a class="link-arrow mt-3" href={withBase("/apply/")}>
						Обсудить вашу ситуацию <Icon name="arrowUpRight" size={14} />
					</a>
				</div>
			</div>
		</div>
	</section>

	<CtaBand
		title="Хотите спокойно, а не «как получится»?"
		text="Начнём с бесплатного разговора. Если ваш сценарий нам не подходит — скажем сразу."
		ctaLabel="Оставить заявку"
		secondaryLabel="Как мы работаем"
		secondaryHref="/process/"
	/>
</BaseLayout>
