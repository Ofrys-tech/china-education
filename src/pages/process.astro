---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import SectionHead from "@/components/SectionHead.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const steps = [
  {
    title: "Диагностика",
    when: "30–60 минут",
    text: "Разбираем цель, академический профиль, язык, бюджет и сроки. На этом же этапе честно говорим, если выбранный сценарий нереалистичен.",
    items: ["Цель и дедлайн", "Оценки и язык", "Бюджет семьи", "Ограничения по городу"],
  },
  {
    title: "Стратегия",
    when: "3–7 дней",
    text: "Собираем 3–5 программ в трёх категориях: амбициозные, реалистичные и страховочные. С дедлайнами, стоимостью и шансами на стипендию.",
    items: ["Шорт-лист программ", "Смета на год", "Календарь дедлайнов", "План по языку"],
  },
  {
    title: "Документы",
    when: "2–6 недель",
    text: "Собираем и проверяем пакет: переводы, легализация, рекомендации, эссе, портфолио. Официальные документы вы получаете в своих инстанциях, мы ведём процесс.",
    items: ["Аттестат или диплом", "Транскрипт", "Переводы и апостиль", "Эссе и рекомендации"],
  },
  {
    title: "Подача",
    when: "декабрь–апрель",
    text: "Отправляем заявки, платим сборы, проходим интервью и вступительные испытания. Вся переписка с вузами — на нас, статусы — в одном трекере.",
    items: ["Онлайн-заявки", "Сборы и депозиты", "Интервью", "Ответы комиссиям"],
  },
  {
    title: "Зачисление и переезд",
    when: "май–сентябрь",
    text: "После оффера — депозит, JW202, виза, общежитие, страховка и брифинг. Помогаем с первыми днями на кампусе, а не исчезаем после зачисления.",
    items: ["Оффер и депозит", "JW202 и виза", "Жильё и страховка", "Встреча и адаптация"],
  },
];

const documents = [
  ["Паспорт", "До подачи", "Студент", "Срок действия — не меньше 18 месяцев на момент поездки."],
  [
    "Аттестат / диплом",
    "До подачи",
    "Студент",
    "Оригинал + перевод, при необходимости апостиль/легализация.",
  ],
  ["Транскрипт оценок", "До подачи", "Студент", "Для магистратуры и некоторых бакалавриатов."],
  [
    "Переводы",
    "До подачи",
    "ChinaPath",
    "Проверяем комплектность и соответствие требованиям вуза.",
  ],
  [
    "Рекомендации",
    "3–6 месяцев",
    "Студент + ChinaPath",
    "2 письма от преподавателей или работодателей.",
  ],
  [
    "Мотивационное письмо",
    "3–6 месяцев",
    "ChinaPath",
    "Собираем факты у студента, редактируем и проверяем.",
  ],
  ["Языковой сертификат", "3–6 месяцев", "Студент", "HSK/IELTS/TOEFL — по требованиям программы."],
  [
    "Портфолио",
    "3–6 месяцев",
    "Студент + ChinaPath",
    "Для дизайна, архитектуры, искусства и некоторых IT-программ.",
  ],
];

const mistakes = [
  {
    title: "Подача в один вуз",
    text: "Один отказ не должен означать потерянный год. Всегда несколько вариантов с разным уровнем риска.",
  },
  {
    title: "Старт в июне",
    text: "Документы, переводы и стипендии требуют времени. Поздний старт сужает выбор и повышает стоимость.",
  },
  {
    title: "Вера в «гарантию»",
    text: "Решение принимает вуз. Любая гарантия зачисления — маркетинг, а не юридическая реальность.",
  },
  {
    title: "Непроверенное признание",
    text: "Для медицины, права и инженерии проверяем регулятора вашей страны до подачи, а не после выпуска.",
  },
];
---

<BaseLayout
	title="Как поступить в Китай"
	description="Пошаговый процесс поступления в Китай: диагностика, стратегия, документы, подача, зачисление и виза. Сроки, чек-лист документов и частые ошибки."
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "HowTo",
		name: "Как поступить в вуз Китая",
		description: "Пошаговый процесс: от диагностики профиля до визы и переезда.",
		totalTime: "P12M",
		step: steps.map((step) => ({
			"@type": "HowToStep",
			name: step.title,
			text: step.text,
			url: absoluteUrl("/process/"),
		})),
	}}
>
	<section class="page-hero">
		<div class="shell">
			<Breadcrumbs items={[{ label: "Как поступить" }]} />
			<div class="page-hero__inner">
				<div>
					<span class="eyebrow">Процесс · набор {siteConfig.intake}</span>
					<h1 class="display display--l page-hero__title">Поступление<br />как проект.</h1>
					<p class="lead page-hero__lead">
						Пять этапов, понятные результаты и один куратор. Ниже — вся логика, включая
						неприятные части: сроки, риски и то, что зависит не от нас.
					</p>
				</div>
				<div class="page-hero__aside">
					<p>
						Оптимальный старт — за 8–12 месяцев до сентября. Для стипендий CSC — ещё раньше:
						дедлайны часто приходятся на декабрь–февраль.
					</p>
					<a class="link-arrow mt-2" href={withBase("/apply/")}>
						Проверить свои сроки <Icon name="arrowUpRight" size={14} />
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="process-list">
				{steps.map((step, index) => (
					<article class="process-step reveal">
						<span class="process-step__num">{String(index + 1).padStart(2, "0")}</span>
						<div>
							<p class="mono-label">{step.when}</p>
							<h2 class="display display--m mt-1">{step.title}</h2>
							<p class="mt-2" style="max-width:44rem;color:var(--color-ink-soft)">{step.text}</p>
							<div class="cluster mt-3">
								{step.items.map((item) => <span class="tag">{item}</span>)}
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section--ruled">
		<div class="shell">
			<SectionHead index="01 / Документы" eyebrow="Чек-лист">
				<Fragment slot="title">Что понадобится<br />на самом деле.</Fragment>
				<Fragment slot="aside">
					Список меняется от вуза к вузу, но эти документы нужны почти всегда. Официальные
					оригиналы студент получает сам — мы отвечаем за комплектность, перевод и подачу.
				</Fragment>
			</SectionHead>
			<div class="table-wrap reveal">
				<table class="data-table">
					<thead>
						<tr>
							<th>Документ</th>
							<th>Когда</th>
							<th>Кто готовит</th>
							<th>Комментарий</th>
						</tr>
					</thead>
					<tbody>
						{documents.map((row) => (
							<tr>
								<td><strong>{row[0]}</strong></td>
								<td>{row[1]}</td>
								<td>{row[2]}</td>
								<td>{row[3]}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="note mt-2">
				Требования к легализации, нотариальному заверению и срокам действия справок зависят от
				вуза и страны выдачи документа. Проверяем по официальным правилам на год поступления.
			</p>
		</div>
	</section>

	<section class="section section--ruled">
		<div class="shell">
			<SectionHead index="02 / Календарь" eyebrow="Набор 2027">
				<Fragment slot="title">Год поступления<br />по месяцам.</Fragment>
				<Fragment slot="aside">
					Ориентировочный календарь для старта в сентябре 2027. Точные даты зависят от вуза:
					у стипендий и некоторых программ дедлайны раньше.
				</Fragment>
			</SectionHead>
			<div class="table-wrap reveal">
				<table class="data-table">
					<thead>
						<tr><th>Период</th><th>Что происходит</th><th>Результат</th></tr>
					</thead>
					<tbody>
						<tr><td>Ноябрь–январь</td><td>Диагностика, язык, бюджет, шорт-лист программ и вузов</td><td>Стратегия и смета</td></tr>
						<tr><td>Декабрь–февраль</td><td>Стипендии CSC/провинций, ранние дедлайны</td><td>Заявки на гранты</td></tr>
						<tr><td>Январь–апрель</td><td>Основная волна: документы, эссе, подача</td><td>Пакеты отправлены</td></tr>
						<tr><td>Март–июнь</td><td>Интервью, экзамены, ответы вузов</td><td>Офферы и депозиты</td></tr>
						<tr><td>Июнь–август</td><td>JW202, виза, общежитие, страховка, перелёт</td><td>Готовность к переезду</td></tr>
						<tr><td>Сентябрь</td><td>Регистрация в кампусе и ориентация</td><td>Старт учёбы</td></tr>
					</tbody>
				</table>
			</div>
			<p class="note mt-2">
				Если до сентября меньше шести месяцев — это не приговор, но выбор будет уже. Оценим
				реальные варианты на консультации.
			</p>
		</div>
	</section>

	<section class="section section--ruled">
		<div class="shell">
			<SectionHead index="03 / Риски" eyebrow="Частые ошибки">
				<Fragment slot="title">Где обычно<br />ломается.</Fragment>
				<Fragment slot="aside">
					Эти четыре ошибки встречаются чаще всего. Мы проектируем процесс так, чтобы они не
					стали вашей историей.
				</Fragment>
			</SectionHead>
			<div class="value-grid reveal">
				{mistakes.map((item, index) => (
					<article class="value-card">
						<span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
						<div>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<CtaBand
		title="Проверим ваши сроки и шансы?"
		text="Бесплатная консультация: 30 минут, честная оценка и следующие шаги. Без обязательств."
		ctaLabel="Записаться"
		secondaryLabel="Частые вопросы"
		secondaryHref="/faq/"
	/>
</BaseLayout>
