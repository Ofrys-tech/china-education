---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import SectionHead from "@/components/SectionHead.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const page = copy.process;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: page.meta.title,
  description: page.meta.description,
  totalTime: "P12M",
  step: page.steps.map((step) => ({
    "@type": "HowToStep",
    name: step.title,
    text: step.text,
    url: absoluteUrl("/process/"),
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <a class="link-arrow mt-2" href={withBase("/apply/")}>
            {page.hero.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="process-list">
        {page.steps.map((step, index) => (
          <article class="process-step reveal">
            <span class="process-step__num">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <p class="mono-label">{step.when}</p>
              <h2 class="display display--m mt-1">{step.title}</h2>
              <p class="mt-2" style="max-width:44rem;color:var(--color-ink-soft)">{step.text}</p>
              <div class="cluster mt-3">
                {step.items.map((item) => <span class="tag">{item}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.documents.index} eyebrow={page.documents.eyebrow}>
        <Fragment slot="title"><Lines lines={page.documents.titleLines} /></Fragment>
        <Fragment slot="aside">{page.documents.aside}</Fragment>
      </SectionHead>
      <div class="table-wrap reveal">
        <table class="data-table">
          <thead>
            <tr>{page.documents.headers.map((header) => <th>{header}</th>)}</tr>
          </thead>
          <tbody>
            {page.documents.rows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note mt-2">{page.documents.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.calendar.index} eyebrow={page.calendar.eyebrow}>
        <Fragment slot="title"><Lines lines={page.calendar.titleLines} /></Fragment>
        <Fragment slot="aside">{page.calendar.aside}</Fragment>
      </SectionHead>
      <div class="table-wrap reveal">
        <table class="data-table">
          <thead>
            <tr>{page.calendar.headers.map((header) => <th>{header}</th>)}</tr>
          </thead>
          <tbody>
            {page.calendar.rows.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note mt-2">{page.calendar.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.mistakes.index} eyebrow={page.mistakes.eyebrow}>
        <Fragment slot="title"><Lines lines={page.mistakes.titleLines} /></Fragment>
        <Fragment slot="aside">{page.mistakes.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.mistakes.items.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/faq/"
  />
</BaseLayout>