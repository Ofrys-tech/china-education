---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Lines from "@/components/Lines.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";

const page = copy.privacy;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.meta.title,
  inLanguage: siteConfig.lang,
  dateModified: "2026-11-07",
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} noindex jsonLd={pageLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p class="mono-label">{page.hero.updatedLabel}</p>
          <p>{page.hero.updated}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="legal">
        {page.sections.map((section) => (
          <>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {"list" in section && section.list && (
              <ul>
                {section.list.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {"after" in section && section.after && section.after.map((paragraph) => <p>{paragraph}</p>)}
            {"contactAfter" in section && section.contactAfter && (
              <p>
                {page.contact.before}{" "}
                <a href={withBase("/apply/")}>{page.contact.linkLabel}</a>{" "}
                {page.contact.between}{" "}
                {siteConfig.contacts.email ? (
                  <a href={`mailto:${siteConfig.contacts.email}`}>{siteConfig.contacts.email}</a>
                ) : (
                  page.contact.emailFallback
                )}
                .
              </p>
            )}
          </>
        ))}

        <p class="note mt-5">{page.finalNote}</p>
      </div>
    </div>
  </section>
</BaseLayout>