---
import PageHero from "@/components/PageHero.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const page = copy.privacy;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.meta.title,
  inLanguage: siteConfig.lang,
  dateModified: "2026-11-09",
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} noindex jsonLd={pageLd}>
  <PageHero
    breadcrumb={page.breadcrumb}
    eyebrow={page.hero.eyebrow}
    titleLines={page.hero.titleLines}
    lead={page.hero.lead}
    aside={`${page.hero.updatedLabel}: ${page.hero.updated}`}
    emblem={false}
  />

  <section class="section">
    <div class="shell">
      <div class="legal">
        {page.sections.map((section) => (
          <>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {"list" in section && section.list && (
              <ul>
                {section.list.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {"after" in section && section.after && section.after.map((paragraph) => <p>{paragraph}</p>)}
          </>
        ))}
        <p class="note mt-5">
          Questions about this policy: <a href={`mailto:${siteConfig.contacts.email}`}>{siteConfig.contacts.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
