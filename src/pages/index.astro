---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import arrivalKey from "@/assets/generated/icons/arrival-key.png";
import globalCommunity from "@/assets/generated/icons/global-community.png";
import scholarshipLaurel from "@/assets/generated/icons/scholarship-laurel.png";
import CtaBand from "@/components/CtaBand.astro";
import Emblem from "@/components/Emblem.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import LeadForm from "@/components/LeadForm.astro";
import Lines from "@/components/Lines.astro";
import ProgramCard from "@/components/ProgramCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import SuccessCard from "@/components/SuccessCard.astro";
import UniversityCard from "@/components/UniversityCard.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";

const [programs, universities, faq] = await Promise.all([
  getCollection("programs"),
  getCollection("universities"),
  getCollection("faq"),
]);

const page = copy.home;
const featuredPrograms = programs.sort((a, b) => a.data.order - b.data.order);
const featuredUniversities = universities
  .sort((a, b) => a.data.order - b.data.order)
  .filter((university) => university.data.featured)
  .slice(0, 6);
const homeFaq = faq
  .filter((item) => item.data.home)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
const successCards = copy.experience.results.cards.slice(0, 2);

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map((item) => ({
    "@type": "Question",
    name: item.data.question,
    acceptedAnswer: { "@type": "Answer", text: item.data.answer },
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={faqLd}>
  <section class="hero hero--lux">
    <div class="shell hero__inner">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display hero__title hero__title--lux">
            <span class="line">{page.hero.title.line1}</span>
            <span class="line">{page.hero.title.line2}</span>
            <span class="line">
              <span class="accent">{page.hero.title.accent}</span>{page.hero.title.suffix}
            </span>
          </h1>
          <p class="lead hero__lead">{page.hero.lead}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={withBase("/apply/")} data-track="hero_cta">
              {page.hero.primaryCta}
              <Icon name="arrowUpRight" size={17} />
            </a>
            <a class="btn btn--outline-gold" href={withBase("/destinations/")}>
              {page.hero.secondaryCta}
              <Icon name="arrow" size={17} />
            </a>
          </div>
          <p class="hero__note">{page.hero.note}</p>

          <div class="hero__proof">
            {page.hero.proof.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="hero__visual">
          <div class="world-seal" aria-hidden="true">
            <div class="world-seal__ring"></div>
            <div class="world-seal__orbit"><i></i></div>
            <div class="world-seal__orbit world-seal__orbit--b"><i></i></div>
            <span class="world-seal__label world-seal__label--1">{page.hero.seal.labels[0]}</span>
            <span class="world-seal__label world-seal__label--2">{page.hero.seal.labels[1]}</span>
            <span class="world-seal__label world-seal__label--3">{page.hero.seal.labels[2]}</span>
            <span class="world-seal__label world-seal__label--4">{page.hero.seal.labels[3]}</span>
            <div class="world-seal__core"><Emblem /></div>
          </div>

          <div class="hero__quote">
            <span>{page.hero.seal.quoteLabel}</span>
            <strong>{page.hero.seal.quote}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee marquee--lux" aria-hidden="true">
    <div class="marquee__track">
      {page.marquee.map((item) => <span class="marquee__item">{item}</span>)}
      {page.marquee.map((item) => <span class="marquee__item">{item}</span>)}
    </div>
  </div>

  <section class="stat-strip">
    {page.stats.map((stat) => (
      <div class="stat-strip__item">
        <span class="stat-strip__value">{stat.value}</span>
        <span class="stat-strip__label">{stat.label}</span>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="shell">
      <div class="split split--wide">
        <div>
          <span class="eyebrow">{page.philosophy.eyebrow}</span>
          <p class="display display--l mt-3" style="max-width:30ch">{page.philosophy.statement}</p>
        </div>
        <div>
          <p class="lead">{page.philosophy.lead}</p>
          <p class="muted mt-3" style="font-size:.98rem;line-height:1.7">{page.philosophy.aside}</p>
          <a class="link-arrow mt-4" href={withBase("/about/")}>
            Read our philosophy <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.values.index} eyebrow={page.values.eyebrow}>
        <Fragment slot="title"><Lines lines={page.values.titleLines} /></Fragment>
        <Fragment slot="aside">{page.values.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.values.cards.map((card, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.destinations.index} eyebrow={page.destinations.eyebrow}>
        <Fragment slot="title"><Lines lines={page.destinations.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.destinations.aside}
          <a class="link-arrow mt-2" href={withBase("/destinations/")}>
            {page.destinations.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="dest-grid">
        {page.destinations.cards.map((card, index) => (
          <article class:list={["dest-card reveal", { "dest-card--active": card.status === "Active" }]}>
            <div>
              <div class="dest-card__top">
                <span class="dest-card__index">0{index + 1} / 03</span>
                <span class:list={["dest-card__status", { "dest-card__status--soon": card.status !== "Active" }]}>
                  {card.status}
                </span>
              </div>
              <div class="dest-card__glyph" aria-hidden="true">{card.glyph}</div>
              <h3>{card.country}</h3>
              <p>{card.text}</p>
              <div class="dest-card__meta">
                {card.meta.map((item) => <span>{item}</span>)}
              </div>
            </div>
            {card.status === "Active" ? (
              <a class="dest-card__link" href={withBase("/destinations/")}>
                {page.destinations.link} <Icon name="arrowUpRight" size={14} />
              </a>
            ) : (
              <span class="dest-card__link" style="color:rgba(251,247,238,.42)">
                {page.destinations.soonLabel}
              </span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.programs.index} eyebrow={page.programs.eyebrow}>
        <Fragment slot="title"><Lines lines={page.programs.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.programs.aside}
          <a class="link-arrow mt-2" href={withBase("/programs/")}>
            {page.programs.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="program-grid">
        {featuredPrograms.map((program, index) => (
          <ProgramCard
            title={program.data.title}
            summary={program.data.summary}
            degree={program.data.degree}
            duration={program.data.duration}
            languages={program.data.languages}
            tuition={program.data.tuition}
            href={`/programs/${program.id}/`}
            index={index + 1}
            featured={program.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.universities.index} eyebrow={page.universities.eyebrow}>
        <Fragment slot="title"><Lines lines={page.universities.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.universities.aside}
          <a class="link-arrow mt-2" href={withBase("/universities/")}>
            {page.universities.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="uni-grid">
        {featuredUniversities.map((university) => (
          <UniversityCard university={university.data} />
        ))}
      </div>
      <p class="note mt-3">{page.universities.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.scholarships.index} eyebrow={page.scholarships.eyebrow}>
        <Fragment slot="title"><Lines lines={page.scholarships.titleLines} /></Fragment>
        <Fragment slot="aside">{page.scholarships.aside}</Fragment>
      </SectionHead>

      <div class="scholar">
        <div>
          <Image
            src={scholarshipLaurel}
            alt="Gold laurel wreath and star — ADLAS scholarship guidance"
            width={112}
            widths={[64, 112, 224]}
            sizes="112px"
            format="webp"
            class="section-emblem"
            loading="lazy"
          />
          <p class="scholar__mark">
            {page.scholarships.mark}<small>{page.scholarships.markLabel}</small>
          </p>
          <div class="pill-list mt-3">
            {page.scholarships.benefits.map((item) => <span>{item}</span>)}
          </div>
        </div>
        <div>
          <p class="lead">{page.scholarships.lead}</p>
          <div class="scholar__list">
            {page.scholarships.items.map((item) => (
              <div class="scholar__item">
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </div>
            ))}
          </div>
          <a class="link-arrow mt-3" href={withBase("/scholarships/")}>
            {page.scholarships.cta} <Icon name="arrowUpRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="ink section">
    <div class="shell">
      <SectionHead index={page.experience.index} eyebrow={page.experience.eyebrow}>
        <Fragment slot="title"><Lines lines={page.experience.titleLines} /></Fragment>
        <Fragment slot="aside">
          <Image
            src={globalCommunity}
            alt="Gold orbital sphere — the international ADLAS student community"
            width={104}
            widths={[64, 104, 208]}
            sizes="104px"
            format="webp"
            class="section-emblem section-emblem--aside"
            loading="lazy"
          />
          {page.experience.aside}
          <a class="link-arrow mt-2" href={withBase("/experience/")}>
            {page.experience.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="quote-grid">
        {page.experience.stories.map((story) => (
          <article class="quote-card reveal" style="background:rgba(251,247,238,.04);border-color:rgba(251,247,238,.12)">
            <div>
              <span class="quote-card__flag">{story.country}</span>
              <blockquote style="color:var(--color-cream);margin-top:.8rem">“{story.quote}”</blockquote>
            </div>
            <div>
              <p class="quote-card__meta" style="color:rgba(251,247,238,.52)">{story.meta}</p>
              <span class="demo-badge" style="margin-top:.6rem;border-color:rgba(251,247,238,.24);color:rgba(251,247,238,.5)">
                {page.experience.demoLabel}
              </span>
            </div>
          </article>
        ))}
      </div>
      <p class="note mt-3" style="color:rgba(251,247,238,.5)">{page.experience.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index={page.accommodation.index} eyebrow={page.accommodation.eyebrow}>
        <Fragment slot="title"><Lines lines={page.accommodation.titleLines} /></Fragment>
        <Fragment slot="aside">
          <Image
            src={arrivalKey}
            alt="Gold key and orbit — ADLAS accommodation and arrival support"
            width={96}
            widths={[64, 96, 192]}
            sizes="96px"
            format="webp"
            class="section-emblem section-emblem--aside"
            loading="lazy"
          />
          {page.accommodation.aside}
          <a class="link-arrow mt-2" href={withBase("/accommodation/")}>
            {page.accommodation.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="room-grid">
        {page.accommodation.rooms.map((room, index) => (
          <article class="room-card reveal">
            <div class="room-card__art"><span>{String(index + 1).padStart(2, "0")}</span></div>
            <div class="room-card__body">
              <h3>{room.name}</h3>
              <p>{room.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="pill-list mt-4">
        {page.accommodation.facilities.map((item) => <span>{item}</span>)}
      </div>
      <p class="note mt-2">{page.accommodation.note}</p>
    </div>
  </section>

  <section class="ink section">
    <div class="shell">
      <SectionHead index={page.process.index} eyebrow={page.process.eyebrow}>
        <Fragment slot="title"><Lines lines={page.process.titleLines} /></Fragment>
        <Fragment slot="aside">{page.process.aside}</Fragment>
      </SectionHead>

      <div class="steps">
        {page.process.steps.map((step, index) => (
          <article class="step">
            <span class="step__num">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </article>
        ))}
      </div>

      <div class="cluster mt-4" style="justify-content:space-between">
        <p class="note" style="max-width:34rem;color:rgba(251,247,238,.6)">
          {page.process.note}
        </p>
        <a class="btn btn--outline-gold" href={withBase("/process/")}>
          {page.process.cta}
          <Icon name="arrowUpRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--ruled" id="results">
    <div class="shell">
      <SectionHead index={page.success.index} eyebrow={page.success.eyebrow}>
        <Fragment slot="title"><Lines lines={page.success.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.success.aside}
          <a class="link-arrow mt-2" href={withBase("/experience/#results")}>
            {page.success.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="success-grid">
        {successCards.map((card) => <SuccessCard card={card} />)}
      </div>
      <p class="note mt-3">{page.success.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.services.index} eyebrow={page.services.eyebrow}>
        <Fragment slot="title"><Lines lines={page.services.titleLines} /></Fragment>
        <Fragment slot="aside">{page.services.aside}</Fragment>
      </SectionHead>

      <div class="split">
        <div>
          <ul class="checklist">
            {page.services.included.map((item) => (
              <li><Icon name="check" size={16} /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="panel panel--gold">
          <p class="mono-label">{page.services.panelLabel}</p>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.services.notPromised.map((item) => (
              <li><Icon name="x" size={16} /> {item}</li>
            ))}
          </ul>
          <p class="note mt-3">
            {page.services.note} {copy.common.legal.disclaimer}
          </p>
          <a class="btn btn--ghost mt-3" href={withBase("/about/")}>
            {page.services.cta} <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.faq.index} eyebrow={page.faq.eyebrow}>
        <Fragment slot="title"><Lines lines={page.faq.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.faq.aside}
          <a class="link-arrow mt-2" href={withBase("/faq/")}>
            {page.faq.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>
      <FaqList items={homeFaq.map((item) => item.data)} openFirst />
    </div>
  </section>

  <section class="section section--ruled" id="start">
    <div class="shell">
      <div class="split">
        <div>
          <span class="eyebrow">{page.start.eyebrow}</span>
          <h2 class="display display--l mt-2"><Lines lines={page.start.titleLines} /></h2>
          <p class="lead mt-3">{page.start.lead}</p>
          <div class="hero__meta" style="max-width:34rem">
            {page.start.meta.map((item) => (
              <div class="hero__meta-item">
                <span class="hero__meta-value">{item.value}</span>
                <span class="hero__meta-label">{item.label}</span>
              </div>
            ))}
          </div>
          <p class="note mt-3">
            {page.start.note}{" "}
            <a href={withBase("/privacy/")} style="text-decoration:underline">
              {page.start.noteLink}
            </a>.
          </p>
        </div>
        <LeadForm variant="compact" source="home" />
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/faq/"
  />
</BaseLayout>
