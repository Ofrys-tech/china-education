---
import { getCollection } from "astro:content";
import CtaBand from "@/components/CtaBand.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import LeadForm from "@/components/LeadForm.astro";
import Lines from "@/components/Lines.astro";
import ProgramCard from "@/components/ProgramCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import UniversityRow from "@/components/UniversityRow.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";

const [programs, universities, faq] = await Promise.all([
  getCollection("programs"),
  getCollection("universities"),
  getCollection("faq"),
]);

const page = copy.home;
const featuredPrograms = programs.sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const featuredUniversities = universities.sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const homeFaq = faq
  .filter((item) => item.data.home)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map((item) => ({
    "@type": "Question",
    name: item.data.question,
    acceptedAnswer: { "@type": "Answer", text: item.data.answer },
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={faqLd}>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <span class="hero__glyph" aria-hidden="true">{page.hero.glyph}</span>

    <div class="shell hero__inner">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--hero hero__title">
            <span class="line">{page.hero.title.line1}</span>
            <span class="line">{page.hero.title.line2}</span>
            <span class="line">
              <span class="accent">{page.hero.title.accent}</span>{page.hero.title.suffix}
            </span>
          </h1>
          <p class="lead hero__lead">{page.hero.lead}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={withBase("/apply/")} data-track="hero_cta">
              {page.hero.primaryCta}
              <Icon name="arrowUpRight" size={17} />
            </a>
            <a class="btn btn--ghost" href={withBase("/programs/")}>
              {page.hero.secondaryCta}
              <Icon name="arrow" size={17} />
            </a>
          </div>
          <p class="hero__note">{page.hero.note}</p>

          <div class="hero__meta">
            {page.hero.meta.map((item) => (
              <div class="hero__meta-item">
                <span class="hero__meta-value">{item.value}</span>
                <span class="hero__meta-label">{item.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="hero__visual" aria-hidden="true">
          <div class="dossier">
            <div class="dossier__top">
              <span>{page.hero.dossier.topLabel}</span>
              <span>{page.hero.dossier.number}</span>
            </div>
            <div class="dossier__body">
              <p class="dossier__label">{page.hero.dossier.programLabel}</p>
              <p class="dossier__value">{page.hero.dossier.programValue}</p>
              <div class="dossier__rows">
                {page.hero.dossier.rows.map((row) => (
                  <div class="dossier__row">
                    <span>{row.label}</span>
                    <strong>{row.value}</strong>
                  </div>
                ))}
              </div>
              <div class="dossier__progress">
                <span class="dossier__step is-done"></span>
                <span class="dossier__step is-done"></span>
                <span class="dossier__step is-current"></span>
                <span class="dossier__step"></span>
              </div>
            </div>
            <div class="dossier__footer">
              <span class="muted">{page.hero.dossier.statusLabel}</span>
              <span class="dossier__status">{page.hero.dossier.statusValue}</span>
            </div>
          </div>

          <div class="float-card float-card--scholar">
            <span>{page.hero.floats.scholarship.eyebrow}</span>
            <strong>{page.hero.floats.scholarship.title}</strong>
          </div>
          <div class="float-card float-card--lang">
            <span>{page.hero.floats.language.eyebrow}</span>
            <strong>{page.hero.floats.language.title}</strong>
          </div>

          <div class="orbit-badge">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs>
                <path id="orbit-path" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
              </defs>
              <text font-size="8.4" letter-spacing="2.6" fill="currentColor">
                <textPath href="#orbit-path">{page.hero.orbit}</textPath>
              </text>
            </svg>
            <span class="orbit-badge__zh">{page.hero.badge}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {page.marquee.map((item) => <span class="marquee__item">{item}</span>)}
      {page.marquee.map((item) => <span class="marquee__item">{item}</span>)}
    </div>
  </div>

  <section class="section">
    <div class="shell">
      <SectionHead index={page.why.index} eyebrow={page.why.eyebrow}>
        <Fragment slot="title"><Lines lines={page.why.titleLines} /></Fragment>
        <Fragment slot="aside">{page.why.aside}</Fragment>
      </SectionHead>

      <div class="value-grid reveal">
        {page.why.cards.map((card, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.programs.index} eyebrow={page.programs.eyebrow}>
        <Fragment slot="title"><Lines lines={page.programs.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.programs.aside}
          <a class="link-arrow mt-2" href={withBase("/programs/")} style="display:inline-flex">
            {page.programs.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="program-grid">
        {featuredPrograms.map((program, index) => (
          <ProgramCard
            title={program.data.title}
            summary={program.data.summary}
            degree={program.data.degree}
            duration={program.data.duration}
            languages={program.data.languages}
            tuition={program.data.tuition}
            href={`/programs/${program.id}/`}
            index={index + 1}
            featured={program.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.universities.index} eyebrow={page.universities.eyebrow}>
        <Fragment slot="title"><Lines lines={page.universities.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.universities.aside}
          <a class="link-arrow mt-2" href={withBase("/universities/")} style="display:inline-flex">
            {page.universities.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>

      <div class="university-list">
        {featuredUniversities.map((university, index) => (
          <UniversityRow
            name={university.data.name}
            nameZh={university.data.nameZh}
            city={university.data.city}
            strengths={university.data.strengths}
            language={university.data.language}
            scholarship={university.data.scholarship}
            href={withBase("/universities/")}
            index={index + 1}
          />
        ))}
      </div>
      <p class="note mt-2">{page.universities.note}</p>
    </div>
  </section>

  <section class="dark section">
    <div class="shell">
      <SectionHead index={page.process.index} eyebrow={page.process.eyebrow}>
        <Fragment slot="title"><Lines lines={page.process.titleLines} /></Fragment>
        <Fragment slot="aside">{page.process.aside}</Fragment>
      </SectionHead>

      <div class="steps">
        {page.process.steps.map((step, index) => (
          <article class="step">
            <span class="step__num">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </article>
        ))}
      </div>

      <div class="cluster mt-4" style="justify-content:space-between">
        <p class="note" style="max-width:34rem;color:rgba(255,252,246,.66)">
          {page.process.note}
        </p>
        <a class="btn btn--light" href={withBase("/process/")}>
          {page.process.cta}
          <Icon name="arrowUpRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead index={page.scholarships.index} eyebrow={page.scholarships.eyebrow}>
        <Fragment slot="title"><Lines lines={page.scholarships.titleLines} /></Fragment>
        <Fragment slot="aside">{page.scholarships.aside}</Fragment>
      </SectionHead>

      <div class="scholar">
        <div>
          <p class="scholar__mark">
            {page.scholarships.mark}<small>{page.scholarships.markLabel}</small>
          </p>
        </div>
        <div>
          <p class="lead">{page.scholarships.lead}</p>
          <div class="scholar__list">
            {page.scholarships.items.map((item) => (
              <div class="scholar__item">
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </div>
            ))}
          </div>
          <a class="link-arrow mt-3" href={withBase("/apply/")}>
            {page.scholarships.cta} <Icon name="arrowUpRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.services.index} eyebrow={page.services.eyebrow}>
        <Fragment slot="title"><Lines lines={page.services.titleLines} /></Fragment>
        <Fragment slot="aside">{page.services.aside}</Fragment>
      </SectionHead>

      <div class="split">
        <div>
          <ul class="checklist">
            {page.services.included.map((item) => (
              <li><Icon name="check" size={16} /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="panel panel--ruled">
          <p class="mono-label">{page.services.panelLabel}</p>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.services.notPromised.map((item) => (
              <li><Icon name="x" size={16} /> {item}</li>
            ))}
          </ul>
          <p class="note mt-3">
            {page.services.note} {copy.common.legal.disclaimer}
          </p>
          <a class="btn btn--ghost mt-3" href={withBase("/about/")}>
            {page.services.cta} <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.faq.index} eyebrow={page.faq.eyebrow}>
        <Fragment slot="title"><Lines lines={page.faq.titleLines} /></Fragment>
        <Fragment slot="aside">
          {page.faq.aside}
          <a class="link-arrow mt-2" href={withBase("/faq/")} style="display:inline-flex">
            {page.faq.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </Fragment>
      </SectionHead>
      <FaqList items={homeFaq.map((item) => item.data)} openFirst />
    </div>
  </section>

  <section class="section section--ruled" id="start">
    <div class="shell">
      <div class="split">
        <div>
          <span class="eyebrow">{page.start.eyebrow}</span>
          <h2 class="display display--l mt-2"><Lines lines={page.start.titleLines} /></h2>
          <p class="lead mt-3">{page.start.lead}</p>
          <div class="hero__meta" style="max-width:34rem">
            {page.start.meta.map((item) => (
              <div class="hero__meta-item">
                <span class="hero__meta-value">{item.value}</span>
                <span class="hero__meta-label">{item.label}</span>
              </div>
            ))}
          </div>
          <p class="note mt-3">
            {page.start.note}{" "}
            <a href={withBase("/privacy/")} style="text-decoration:underline">
              {page.start.noteLink}
            </a>.
          </p>
        </div>
        <LeadForm variant="compact" source="home" />
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/faq/"
  />
</BaseLayout>