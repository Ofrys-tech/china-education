---
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import ProgramCard from "@/components/ProgramCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import { copy } from "@/i18n";
import { labels } from "@/i18n/en/labels";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const programs = (await getCollection("programs")).sort((a, b) => a.data.order - b.data.order);
const page = copy.programs;

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.meta.title,
  description: page.meta.description,
  url: absoluteUrl("/programs/"),
  isPartOf: { "@type": "WebSite", name: copy.common.meta.siteName, url: absoluteUrl("/") },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={collectionLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <a class="link-arrow mt-2" href={withBase("/apply/")}>
            {page.hero.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="program-grid program-grid--listing">
        {programs.map((program, index) => (
          <ProgramCard
            title={program.data.title}
            summary={program.data.summary}
            degree={program.data.degree}
            duration={program.data.duration}
            languages={program.data.languages}
            tuition={program.data.tuition}
            href={`/programs/${program.id}/`}
            index={index + 1}
            featured={program.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.criteria.index} eyebrow={page.criteria.eyebrow}>
        <Fragment slot="title"><Lines lines={page.criteria.titleLines} /></Fragment>
        <Fragment slot="aside">{page.criteria.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.criteria.cards.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="table-wrap mt-4 reveal">
        <table class="data-table">
          <thead>
            <tr>
              {page.table.headers.map((header) => <th>{header}</th>)}
            </tr>
          </thead>
          <tbody>
            {programs.map((program) => (
              <tr>
                <td>
                  <a href={withBase(`/programs/${program.id}/`)}>
                    {labels.degrees[program.data.degree]}
                  </a>
                </td>
                <td>{program.data.duration}</td>
                <td>{program.data.languages.map((lang) => labels.languages[lang]).join(" / ")}</td>
                <td>{program.data.tuition}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note mt-2">{page.table.note}</p>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/process/"
  />
</BaseLayout>