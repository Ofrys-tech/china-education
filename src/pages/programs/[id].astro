---
import { type CollectionEntry, getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import ProgramCard from "@/components/ProgramCard.astro";
import { siteConfig } from "@/config/site";
import { copy } from "@/i18n";
import { labels } from "@/i18n/en/labels";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

interface Props {
  program: CollectionEntry<"programs">;
}

export async function getStaticPaths() {
  const programs = await getCollection("programs");
  return programs.map((program) => ({
    params: { id: program.id },
    props: { program },
  }));
}

const { program } = Astro.props;
const data = program.data;
const page = copy.programs;
const detail = page.detail;
const url = absoluteUrl(`/programs/${program.id}/`);

const others = (await getCollection("programs"))
  .filter((item) => item.id !== program.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const courseLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: data.title,
  description: data.summary,
  url,
  inLanguage: data.languages,
  provider: {
    "@type": "Organization",
    name: siteConfig.name,
    url: absoluteUrl("/"),
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "full-time",
  },
};
---

<BaseLayout title={data.title} description={data.summary} jsonLd={[courseLd, faqLd]}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs
        items={[
          { label: page.breadcrumb, href: "/programs/" },
          { label: labels.degrees[data.degree] },
        ]}
      />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{labels.degrees[data.degree]}{detail.eyebrowSuffix}</span>
          <h1 class="display display--l page-hero__title">{data.title}</h1>
          <p class="lead page-hero__lead">{data.summary}</p>
          <div class="cluster mt-3">
            <span class="tag">{data.duration}</span>
            <span class="tag">{data.languages.map((lang) => labels.languages[lang]).join(" / ")}</span>
            <span class="tag tag--red">{data.tuition}</span>
          </div>
        </div>
        <div class="page-hero__aside">
          <p class="mono-label">{detail.costLabel}</p>
          <p>{data.tuition}</p>
          <p class="note mt-2">{detail.costNote}</p>
          <a class="btn btn--primary mt-3" href={withBase("/apply/")}>
            {detail.cta} <Icon name="arrowUpRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="detail-grid">
        <div class="prose">
          {data.overview.map((paragraph) => <p>{paragraph}</p>)}

          <h2>{detail.timelineTitle}</h2>
          <div class="timeline mt-2">
            {data.timeline.map((item) => (
              <div class="timeline__item">
                <span class="timeline__step">{item.step}</span>
                <p class="timeline__text">{item.text}</p>
              </div>
            ))}
          </div>

          <h2>{detail.outcomesTitle}</h2>
          <ul>
            {data.outcomes.map((item) => <li>{item}</li>)}
          </ul>

          {data.faq.length > 0 && (
            <>
              <h2>{detail.faqTitle}</h2>
              <FaqList items={data.faq} openFirst />
            </>
          )}
        </div>

        <aside class="detail-aside">
          <div class="panel panel--ruled">
            <p class="mono-label">{detail.fitLabel}</p>
            <ul class="checklist mt-2" style="grid-template-columns:1fr">
              {data.fitFor.map((item) => (
                <li><Icon name="check" size={15} /> {item}</li>
              ))}
            </ul>
          </div>
          <div class="panel">
            <p class="mono-label">{detail.nextLabel}</p>
            <p class="mt-2" style="font-size:.9rem">{detail.nextText}</p>
            <a class="btn btn--primary mt-3" href={withBase("/apply/")}>
              {detail.nextCta} <Icon name="arrowUpRight" size={15} />
            </a>
          </div>
          <p class="note">{copy.common.legal.disclaimer}</p>
        </aside>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section section--ruled">
      <div class="shell">
        <div class="section-head">
          <div>
            <span class="section-head__index">{detail.relatedIndex}</span>
            <div class="display display--m">{detail.relatedTitle}</div>
          </div>
          <div class="section-head__aside">
            <a class="link-arrow" href={withBase("/programs/")}>
              {detail.allPrograms} <Icon name="arrowUpRight" size={14} />
            </a>
          </div>
        </div>
        <div class="program-grid">
          {others.map((item, index) => (
            <ProgramCard
              title={item.data.title}
              summary={item.data.summary}
              degree={item.data.degree}
              duration={item.data.duration}
              languages={item.data.languages}
              tuition={item.data.tuition}
              href={`/programs/${item.id}/`}
              index={index + 1}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand
    title={detail.ctaBand.title}
    text={detail.ctaBand.text}
    ctaLabel={detail.ctaBand.primary}
    secondaryLabel={detail.ctaBand.secondary}
    secondaryHref="/programs/"
  />
</BaseLayout>
