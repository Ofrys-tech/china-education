---
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const page = copy.destinations;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.meta.title,
  description: page.meta.description,
  url: absoluteUrl("/destinations/"),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <PageHero
    breadcrumb={page.breadcrumb}
    eyebrow={page.hero.eyebrow}
    titleLines={page.hero.titleLines}
    lead={page.hero.lead}
    aside={page.hero.aside}
    link={page.hero.link}
    linkHref="/universities/"
  />

  <section class="section">
    <div class="shell">
      <SectionHead index={page.china.index} eyebrow={page.china.eyebrow}>
        <Fragment slot="title"><Lines lines={page.china.titleLines} /></Fragment>
        <Fragment slot="aside">{page.china.lead}</Fragment>
      </SectionHead>

      <div class="value-grid reveal">
        {page.china.reasons.map((reason, index) => (
          <article class="lux-card">
            <span class="lux-card__kicker">0{index + 1} / China</span>
            <h3 class="mt-2">{reason.title}</h3>
            <p>{reason.text}</p>
          </article>
        ))}
      </div>

      <div class="split mt-5">
        <div>
          <p class="mono-label">{page.china.cities.label}</p>
          <div class="pill-list mt-2">
            {page.china.cities.items.map((city) => <span>{city}</span>)}
          </div>
          <a class="btn btn--primary mt-4" href={withBase("/universities/")}>
            Browse universities <Icon name="arrowUpRight" size={16} />
          </a>
        </div>
        <div>
          <p class="mono-label">{page.china.timeline.label}</p>
          <div class="timeline mt-2">
            {page.china.timeline.rows.map((row) => (
              <div class="timeline__item">
                <span class="timeline__step">{row[0]}</span>
                <p class="timeline__text">{row[1]}</p>
              </div>
            ))}
          </div>
          <p class="note mt-2">{page.china.timeline.note}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ink section">
    <div class="shell">
      <SectionHead index={page.upcoming.index} eyebrow={page.upcoming.eyebrow}>
        <Fragment slot="title"><Lines lines={page.upcoming.titleLines} /></Fragment>
        <Fragment slot="aside">{page.upcoming.aside}</Fragment>
      </SectionHead>

      <div class="success-grid">
        {page.upcoming.cards.map((card) => (
          <article class="success-card" style="background:rgba(251,247,238,.04);border-color:rgba(251,247,238,.14)">
            <div class="success-card__top" style="border-color:rgba(251,247,238,.14)">
              <div>
                <span class="success-card__label" style="color:var(--color-gold)">{card.status}</span>
                <h3 class="success-card__uni" style="color:var(--color-cream)">{card.country}</h3>
              </div>
              <span class="success-card__seal" style="border-color:var(--color-gold);color:var(--color-gold)">
                {card.country.slice(0, 2).toUpperCase()}
              </span>
            </div>
            <p class="mt-3" style="color:rgba(251,247,238,.62);font-size:.92rem;line-height:1.6">{card.text}</p>
            <p class="note mt-3" style="color:rgba(251,247,238,.42)">{page.upcoming.cta}</p>
          </article>
        ))}
      </div>

      <div class="cluster mt-4">
        <a class="btn btn--outline-gold" href={withBase("/contact/")}>
          {page.upcoming.cta} <Icon name="arrowUpRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/universities/"
  />
</BaseLayout>
