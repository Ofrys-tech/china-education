---
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import { copy } from "@/i18n";
import { labels } from "@/i18n/en/labels";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";

const faq = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const page = copy.faq;
const groupOrder = ["admission", "money", "language", "documents", "life"] as const;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.data.question,
    acceptedAnswer: { "@type": "Answer", text: item.data.answer },
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={faqLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <a class="link-arrow mt-2" href={withBase("/apply/")}>
            {page.hero.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell" style="max-width:62rem">
      {groupOrder.map((category) => {
        const items = faq.filter((item) => item.data.category === category);
        if (!items.length) return null;
        return (
          <div class="faq-group">
            <div class="faq-group__head">
              <span class="mono-label">{labels.faqCategories[category]}</span>
              <span class="mono-label">{String(items.length).padStart(2, "0")}</span>
            </div>
            <FaqList items={items.map((item) => item.data)} />
          </div>
        );
      })}
      <p class="note mt-4">{page.note}</p>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/process/"
  />
</BaseLayout>