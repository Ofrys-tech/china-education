---
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import SectionHead from "@/components/SectionHead.astro";
import UniversityRow from "@/components/UniversityRow.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const universities = (await getCollection("universities")).sort(
  (a, b) => a.data.order - b.data.order,
);
const page = copy.universities;

const pageLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.meta.title,
  description: page.meta.description,
  url: absoluteUrl("/universities/"),
  isPartOf: { "@type": "WebSite", name: copy.common.meta.siteName, url: absoluteUrl("/") },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: page.breadcrumb }]} />
      <div class="page-hero__inner">
        <div>
          <span class="eyebrow">{page.hero.eyebrow}</span>
          <h1 class="display display--l page-hero__title"><Lines lines={page.hero.titleLines} /></h1>
          <p class="lead page-hero__lead">{page.hero.lead}</p>
        </div>
        <div class="page-hero__aside">
          <p>{page.hero.aside}</p>
          <a class="link-arrow mt-2" href={withBase("/apply/")}>
            {page.hero.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="university-list">
        {universities.map((university, index) => (
          <UniversityRow
            name={university.data.name}
            nameZh={university.data.nameZh}
            city={university.data.city}
            strengths={university.data.strengths}
            language={university.data.language}
            scholarship={university.data.scholarship}
            href={university.data.officialUrl}
            index={index + 1}
            external
            note={university.data.note}
          />
        ))}
      </div>
      <p class="note mt-3">{page.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.criteria.index} eyebrow={page.criteria.eyebrow}>
        <Fragment slot="title"><Lines lines={page.criteria.titleLines} /></Fragment>
        <Fragment slot="aside">{page.criteria.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.criteria.cards.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="split mt-5">
        <div class="panel panel--ruled">
          <p class="mono-label">{page.checks.label}</p>
          <ul class="checklist checklist--cross mt-2" style="grid-template-columns:1fr">
            {page.checks.items.map((item) => (
              <li><Icon name="check" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="display display--m">{page.fit.title}</h3>
          {page.fit.paragraphs.map((paragraph) => (
            <p class="muted mt-2" style="font-size:.95rem">{paragraph}</p>
          ))}
          <a class="link-arrow mt-3" href={withBase("/process/")}>
            {page.fit.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/programs/"
  />
</BaseLayout>