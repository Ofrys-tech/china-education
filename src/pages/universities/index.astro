---
import { getCollection } from "astro:content";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Lines from "@/components/Lines.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import UniversityCard from "@/components/UniversityCard.astro";
import { copy } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@/lib/url";

const universities = (await getCollection("universities")).sort(
  (a, b) => a.data.order - b.data.order,
);
const page = copy.universities;

const filters = [
  { value: "all", label: page.search.all },
  { value: "language", label: page.search.language },
  { value: "foundation", label: page.search.foundation },
  { value: "bachelor", label: page.search.bachelor },
  { value: "master", label: page.search.master },
  { value: "phd", label: page.search.phd },
  { value: "vocational", label: page.search.vocational },
];

const pageLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.meta.title,
  description: page.meta.description,
  url: absoluteUrl("/universities/"),
  isPartOf: { "@type": "WebSite", name: copy.common.meta.siteName, url: absoluteUrl("/") },
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} jsonLd={pageLd}>
  <PageHero
    breadcrumb={page.breadcrumb}
    eyebrow={page.hero.eyebrow}
    titleLines={page.hero.titleLines}
    lead={page.hero.lead}
    aside={page.hero.aside}
    link={page.hero.link}
    linkHref="/apply/"
  />

  <section class="section">
    <div class="shell">
      <div class="uni-toolbar">
        <label class="uni-search">
          <span class="sr-only">{page.search.label}</span>
          <Icon name="search" size={17} />
          <input
            type="search"
            placeholder={page.search.placeholder}
            data-uni-search
            autocomplete="off"
          />
        </label>
        <div class="uni-filters" role="group" aria-label={page.search.filtersLabel}>
          {filters.map((filter) => (
            <button
              class="uni-filter"
              type="button"
              data-uni-filter={filter.value}
              aria-pressed={filter.value === "all" ? "true" : "false"}
            >{filter.label}</button>
          ))}
        </div>
        <span class="uni-count" data-uni-count aria-live="polite">
          {universities.length} {page.search.count}
        </span>
      </div>

      <div class="uni-grid">
        {universities.map((university) => (
          <UniversityCard university={university.data} />
        ))}
      </div>
      <p class="uni-empty" data-uni-empty hidden>{page.search.empty}</p>
      <p class="note mt-3">{page.note}</p>
    </div>
  </section>

  <section class="section section--ruled">
    <div class="shell">
      <SectionHead index={page.criteria.index} eyebrow={page.criteria.eyebrow}>
        <Fragment slot="title"><Lines lines={page.criteria.titleLines} /></Fragment>
        <Fragment slot="aside">{page.criteria.aside}</Fragment>
      </SectionHead>
      <div class="value-grid reveal">
        {page.criteria.cards.map((item, index) => (
          <article class="value-card">
            <span class="value-card__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="split mt-5">
        <div class="panel panel--ruled">
          <p class="mono-label">{page.checks.label}</p>
          <ul class="checklist mt-2" style="grid-template-columns:1fr">
            {page.checks.items.map((item) => (
              <li><Icon name="check" size={15} /> {item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="display display--m">{page.fit.title}</h3>
          {page.fit.paragraphs.map((paragraph) => (
            <p class="muted mt-2" style="font-size:.98rem">{paragraph}</p>
          ))}
          <a class="link-arrow mt-3" href={withBase("/process/")}>
            {page.fit.link} <Icon name="arrowUpRight" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={page.cta.title}
    text={page.cta.text}
    ctaLabel={page.cta.primary}
    secondaryLabel={page.cta.secondary}
    secondaryHref="/programs/"
  />
</BaseLayout>

<script>
  import "@/scripts/university-search";
</script>
